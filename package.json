{
  "name": "orion-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node site/build.mjs",
    "start": "npm run build && node site/serve.mjs",
    "preview": "node site/serve.mjs",
    "verify": "node site/verify.mjs",
    "check": "npm run build && npm run verify",
    "format": "prettier --write \"site/src/**/*.{jsx,js}\" \"site/styles/*.css\" \"site/*.{mjs,md}\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10"
  }
}
